# Copy to apps/gateway/.env (ignored by Git). Never put these values in the web app.

# "mock" runs without credentials. "deepseek" calls the live API from this server only.
AI_PROVIDER=mock

# Required for AI_PROVIDER=deepseek. Create a key in your own DeepSeek account.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# json_object is the default and the measured better option: on the recorded
# prompt set, strict_tool returned malformed JSON on 7 of 57 cases, and cost more
# tokens and latency. strict_tool remains available for comparison on new models.
DEEPSEEK_OUTPUT_MODE=json_object
DEEPSEEK_MAX_OUTPUT_TOKENS=6000

# Required for AI_PROVIDER=deepseek or a non-loopback host. Use at least 32 random characters,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_ACCESS_TOKEN=

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GENERATION_TIMEOUT_MS=90000
RATE_LIMIT_PER_MINUTE=6
DAILY_REQUEST_LIMIT=200
DAILY_TOKEN_LIMIT=400000
